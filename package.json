  "lint-staged": {
    "src/**/*.{js,jsx,json,css}": [
      "prettier --print-width 120 --tab-width 4 --single-quote --jsx-single-quote --bracket-spacing --write",
      "git add"
    ]
  },
  "scripts": {
    "precommit": "lint-staged",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build && workbox-build injectManifest --config workbox-config.js",
    "test": "react-app-rewired test --env=jsdom",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "stats": "react-app-rewired build --bundle-report && npx webpack-bundle-analyzer ./build/bundle-stats.json"
  },
